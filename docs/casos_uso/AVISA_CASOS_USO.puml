' =====================================================================
'  AVISA-PRODUCE · Casos de uso (PlantUML · UML puro)
' =====================================================================
'  Tres láminas, una por tabla del ERS §3.4:
'    AVISA_CU_MVP_DIA.svg     -> §3.4 «Página 1 — el día del analista»
'    AVISA_CU_MVP_SALIDA.svg  -> §3.4 «Página 2 — lo que se valida, se
'                                envía y se administra»
'    AVISA_CU_2027.svg        -> §3.4 «Página 3 — 2027 y fase MADRE»
'
'  Regla de mantenimiento (ERS §3.4): cada caso lleva su código CU-nn y
'  existe una fila con sus RF en la tabla correspondiente. Un caso sin RF
'  es un error; un RF que no aparezca en ningún caso debe justificarse.
'
'  Regenerar, desde la carpeta docs/:
'    java -jar plantuml.jar -tsvg -charset UTF-8 -o img \
'        casos_uso/AVISA_CASOS_USO.puml
'
'  Graphviz es lo recomendado. Sin Graphviz, añadir -Playout=smetana:
'  no falla, pero el trazado queda peor.
' =====================================================================

@startuml AVISA_CU_MVP_DIA
left to right direction
skinparam shadowing false
skinparam roundcorner 12
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 12
skinparam ranksep 60

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
  FontStyle bold
}
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  BorderStyle dashed
  FontColor #475569
  FontStyle bold
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
  FontColor #0F172A
  ArrowColor #475569
}
skinparam actor {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  FontColor #0F172A
}

title AVISA-PRODUCE · Casos de uso del MVP · Página 1 de 3\nEl día del analista · CU-01 a CU-13

' =========================================================
' 1. ACTORES PRIMARIOS (Izquierda)
' =========================================================
actor "Analista / Sectorista\n(OAIPCS)" as analista #EFF6FF;line:1D4ED8
actor "Analista con privilegio\nRENIEC (hoy, Edith)" as reniec #EFF6FF;line:1D4ED8

' Herencia de roles: un solo CU-01 sirve a todos los perfiles
reniec --|> analista

reniec -[hidden]down-> analista

' =========================================================
' 2. FRONTERA DEL SISTEMA
' =========================================================
rectangle "Plataforma AVISA-PRODUCE / SIPRECS (MVP)" {

  package "Acceso e identidad" {
    usecase "CU-01 · Ingresar con identidad\ninstitucional" as uc_login
    usecase "CU-10 · Registrar consulta\nPIDE-RENIEC" as uc_pide
  }

  package "Gestión territorial y actores" {
    usecase "CU-02 · Registrar y consultar\nactores y organizaciones" as uc_actores
    usecase "CU-03 · Registrar actor\nsin DNI" as uc_sin_dni
    usecase "CU-05 · Registrar compromisos,\nrelatorías y mesas" as uc_compromisos
    usecase "CU-06 · Consultar compromisos\nde un caso" as uc_cons_comp
    usecase "CU-11 · Consultar fichas,\ndirectorios y reportes" as uc_reportes
    usecase "CU-12 · Exportar listas de asistencia\ny mapa de actores" as uc_exportar
  }

  package "Alertas tempranas" {
    usecase "CU-07 · Cargar alerta\ntemprana" as uc_alerta
  }

  package "Productos" {
    usecase "CU-13 · Armar y enviar\nproductos" as uc_productos
  }
}

' =========================================================
' 3. SISTEMAS EXTERNOS QUE ESTA LÁMINA USA
' =========================================================
actor "Plataforma PIDE\n(RENIEC)" as sys_pide #F1F5F9;line:64748B
actor "Repositorio documental\n(Google Drive)" as sys_drive #F1F5F9;line:64748B
actor "Correo institucional" as sys_mail #F1F5F9;line:64748B

sys_pide -[hidden]down-> sys_drive
sys_drive -[hidden]down-> sys_mail

' =========================================================
' 4. RELACIONES ACTOR → CASO
' =========================================================
analista --> uc_login
reniec --> uc_pide

analista --> uc_actores
analista --> uc_compromisos
analista --> uc_cons_comp
analista --> uc_reportes
analista --> uc_exportar
analista --> uc_alerta
analista --> uc_productos

' =========================================================
' 5. RELACIONES ENTRE CASOS
' =========================================================
uc_sin_dni ..> uc_actores : <<extend>>
uc_exportar ..> uc_reportes : <<extend>>
uc_pide ..> uc_login : <<include>>

' =========================================================
' 6. INTEGRACIONES EXTERNAS
' =========================================================
uc_pide --> sys_pide
uc_reportes --> sys_drive
uc_productos --> sys_drive
uc_productos --> sys_mail

' =========================================================
' 7. CONTROLES TRANSVERSALES (no son casos de uso · ERS §3.4)
' =========================================================





@enduml


