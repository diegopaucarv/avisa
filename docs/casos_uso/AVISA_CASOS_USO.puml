    usecase "CU-05 · Registrar compromisos,\nrelatorías y mesas" as uc_compromisos
    usecase "CU-06 · Consultar compromisos\nde un caso" as uc_cons_comp
    usecase "CU-11 · Consultar fichas,\ndirectorios y reportes" as uc_reportes
    usecase "CU-12 · Exportar listas de asistencia\ny mapa de actores" as uc_exportar
  }

