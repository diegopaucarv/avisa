' =====================================================================
'  AVISA-PRODUCE · Casos de uso (sistema)
' =====================================================================
'  QUÉ ES
'  Diagrama de casos de uso del ERS (docs/ERS_AVISA_PRODUCE_v0.4.md §3.4),
'  dibujado con C4-PlantUML porque Mermaid no tiene notación de casos de
'  uso y el resto del ERS ya usa C4 para los niveles 1 a 3.
'
'  REGLA UML QUE SE RESPETA
'  Los actores son EXTERNOS al sistema: ninguna persona ni servicio aparece
'  dentro de la frontera. La frontera encierra solo los casos de uso.
'  Los servicios por integrar (SVC-xx) son actores secundarios, como manda
'  UML: quien intercambia mensajes con el sistema es actor.
'
'  TRAZABILIDAD
'  Cada caso lleva en su descripción los códigos RF del ERS §4, de modo que
'  el diagrama se puede auditar contra el documento sin ambigüedad.
'
'  TRES PÁGINAS
'    1 · AVISA_CU_MVP_DIA       el trabajo diario del analista
'    2 · AVISA_CU_MVP_SALIDA    lo que se valida, se envía y se administra
'    3 · AVISA_CU_2027          lo que queda para 2027 y la fase MADRE
'  Se parte en tres porque un solo lienzo con 34 casos y 12 actores no se
'  lee: las aristas cruzan la frontera de lado a lado y el texto se pierde.
'  CU-01 (ingresar) aparece en las páginas 1 y 2 porque todos los actores
'  lo usan; no son dos casos distintos.
'
'  CÓMO SE RENDERIZA
'     java -jar plantuml.jar -tsvg docs/casos_uso/AVISA_CASOS_USO.puml
'  Sin Graphviz instalado, se fuerza el layout `smetana` (Java puro) con
'     java -jar plantuml.jar -Playout=smetana -tsvg docs/casos_uso/AVISA_CASOS_USO.puml
'  El resultado es menos ordenado, pero no exige instalar nada más.
' =====================================================================


@startuml AVISA_CU_MVP_DIA
!include <C4/C4_Container>
LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()
skinparam shadowing false

title AVISA-PRODUCE · Casos de uso · MVP, página 1 de 2: el día del analista\nActores fuera de la frontera · cada caso cita sus RF del ERS §4

' ACTORES (personas, externas al sistema)
Person_Ext(analista, "Analista / sectorista OAIPCS", "Perfil A · INT-01 · carga, valida y consulta")
Person_Ext(reniec, "Analista con privilegio RENIEC", "Perfil A + privilegio · INT-11 · hoy Edith · RA-07")

' FRONTERA DEL SISTEMA
System_Boundary(sis, "AVISA-PRODUCE / SIPRECS") {
  Container(cu01, "CU-01 Ingresar con\nidentidad institucional", "RF del ERS §4", "RF-A01 · el perfil y la seguridad por fila se aplican en todo caso posterior (RF-A02 a A04)")
  Container(cu02, "CU-02 Registrar y consultar\nactores y organizaciones", "RF del ERS §4", "RF-B01, B03, B05, B07, B08")
  Container(cu03, "CU-03 Registrar un\nactor sin DNI", "RF del ERS §4", "RF-B01, B02 · extiende CU-02")
  Container(cu05, "CU-05 Registrar compromisos,\nrelatorías y mesas", "RF del ERS §4", "RF-C01, C02, C04")
  Container(cu06, "CU-06 Consultar compromisos\nde un caso", "RF del ERS §4", "RF-C05")
  Container(cu07, "CU-07 Cargar alerta temprana", "RF del ERS §4", "RF-D01, D03, D05")
  Container(cu10, "CU-10 Registrar consulta\nPIDE-RENIEC", "RF del ERS §4", "RF-D13 · solo el privilegio nombrado, con motivo y fecha")
  Container(cu11, "CU-11 Consultar fichas,\ndirectorios y reportes", "RF del ERS §4", "RF-F01 a F05, F07")
  Container(cu12, "CU-12 Exportar listas de\nasistencia y mapa de actores", "RF del ERS §4", "RF-F08")
  Container(cu13, "CU-13 Armar y enviar productos", "RF del ERS §4", "RF-G01, G03, G06")
}

' ACTORES SECUNDARIOS (servicios)
System_Ext(svc09, "SVC-09 Identidad institucional", "Login · H-52 por definir")
System_Ext(svc16, "SVC-16 PIDE-RENIEC", "Requisitorias y antecedentes")
System_Ext(svc05, "SVC-05 Google Drive", "Borradores de productos")
System_Ext(svc06, "SVC-06 Correo institucional", "Envío de productos")

' ASOCIACIONES
Rel(analista, cu01, "")
Rel(reniec, cu01, "")
Rel(analista, cu02, "")
Rel(analista, cu05, "")
Rel(analista, cu06, "")
Rel(analista, cu07, "")
Rel(analista, cu11, "")
Rel(analista, cu12, "")
Rel(analista, cu13, "")
Rel(reniec, cu10, "")

Rel(cu03, cu02, "«extend»")
Rel(cu01, svc09, "")
Rel(cu10, svc16, "")
Rel(cu13, svc05, "")
Rel(cu13, svc06, "")
@enduml


