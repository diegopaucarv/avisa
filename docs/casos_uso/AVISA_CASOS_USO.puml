    usecase "CU-24 · Ver la red\nde actores" as uc_red
    usecase "CU-25 · Ver línea de tiempo\ny mapa" as uc_mapa
    usecase "CU-28 · Analizar la pota\nen el tiempo" as uc_pota
    usecase "CU-26 · Ver indicadores\navanzados" as uc_indicadores
    usecase "CU-27 · Simular escenarios\ny tendencia" as uc_escenarios
  }

  package "Monitoreo automatizado e IA asistida" {
    usecase "CU-20 · Procesar documentos y\nproponer candidatos" as uc_procesar
    usecase "CU-21 · Recolectar fuentes\nde la lista blanca" as uc_fuentes
    usecase "CU-22 · Revisar candidatos y\ncoincidencias dudosas" as uc_revisar
    usecase "CU-29 · Generar borradores\nde informe" as uc_borradores
    usecase "CU-30 · Avisar vencimientos y escalar\nalertas sin atender" as uc_escalar
