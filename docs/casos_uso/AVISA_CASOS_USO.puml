actor "Analista / Sectorista\n(OAIPCS)" as analista #EFF6FF;line:1D4ED8
actor "Analista con privilegio\nRENIEC (hoy, Edith)" as reniec #EFF6FF;line:1D4ED8
actor "Procesos automáticos\nprogramados (CT-04)" as reloj #FEF3C7;line:B45309

