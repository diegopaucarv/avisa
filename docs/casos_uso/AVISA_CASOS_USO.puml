actor "Procesos automáticos\nprogramados (CT-04)" as reloj #FEF3C7;line:B45309
actor "Analista / Sectorista\n(OAIPCS)" as analista27 #EFF6FF;line:1D4ED8
actor "Dirección de la OAIPCS" as direccion27 #EFF6FF;line:1D4ED8
actor "Alta Dirección" as alta27 #EFF6FF;line:1D4ED8
actor "Actor externo o gremio\n(perfil C, acceso acotado)" as externo #EFF6FF;line:1D4ED8
actor "Administrador Funcional" as admin27 #EFF6FF;line:1D4ED8

reloj -[hidden]down-> analista27
analista27 -[hidden]down-> direccion27
direccion27 -[hidden]down-> alta27
alta27 -[hidden]down-> externo
externo -[hidden]down-> admin27

' =========================================================
' 2. FRONTERA DEL SISTEMA
' =========================================================
rectangle "Plataforma AVISA-PRODUCE / SIPRECS (evolución 2027)" {

  package "Inteligencia territorial y escenarios" {
