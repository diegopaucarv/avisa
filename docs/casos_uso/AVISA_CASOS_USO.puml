title AVISA-PRODUCE · Casos de uso del MVP · Página 2 de 3\nLo que se valida, se envía y se administra · CU-01 y CU-04 a CU-19

' =========================================================
' 1. ACTORES PRIMARIOS (Izquierda)
' =========================================================
actor "Dirección de la OAIPCS" as direccion #EFF6FF;line:1D4ED8
actor "Alta Dirección\n(Despacho Ministerial y Gabinete)" as alta #EFF6FF;line:1D4ED8
actor "Administrador Funcional" as admin #EFF6FF;line:1D4ED8
actor "Oficina General de Tecnologías\nde la Información (OGTI)" as ogti #EFF6FF;line:1D4ED8

direccion -[hidden]down-> alta
alta -[hidden]down-> admin
admin -[hidden]down-> ogti

' =========================================================
' 2. FRONTERA DEL SISTEMA
' =========================================================
rectangle "Plataforma AVISA-PRODUCE / SIPRECS (MVP)" {

  package "Acceso" {
    usecase "CU-01 · Ingresar con identidad\ninstitucional" as uc_login
  }

  package "Validación y difusión" {
    usecase "CU-04 · Fusionar actores\nduplicados" as uc_fusionar
    usecase "CU-08 · Validar alerta\no clima social" as uc_validar
    usecase "CU-09 · Calcular destinatarios\ny enviar la alerta" as uc_difundir
  }

  package "Decisión ejecutiva" {
    usecase "CU-14 · Ver tableros\ny vista ejecutiva" as uc_tableros
  }

  package "Gobierno, auditoría y administración" {
    usecase "CU-15 · Verificar la carga\ndel sistema anterior" as uc_migracion
    usecase "CU-16 · Administrar usuarios,\nroles y catálogos" as uc_usuarios
    usecase "CU-17 · Consultar la bitácora\nde accesos" as uc_bitacora
    usecase "CU-18 · Respaldar y recuperar\nla base" as uc_respaldo
    usecase "CU-19 · Configurar el modelo\nde lenguaje" as uc_ia
  }
}

' =========================================================
' 3. SISTEMAS EXTERNOS QUE ESTA LÁMINA USA
' =========================================================
actor "Identidad institucional\n(acceso único)" as sys_sso #F1F5F9;line:64748B
actor "Correo institucional" as sys_mail #F1F5F9;line:64748B
actor "Repositorio documental\n(Google Drive)" as sys_drive #F1F5F9;line:64748B
actor "Mensajería ejecutiva\n(WhatsApp institucional)" as sys_wa #F1F5F9;line:64748B
actor "Analítica ejecutiva\n(Power BI, 2 salidas)" as sys_bi #F1F5F9;line:64748B
actor "Sistema anterior\n(hojas de cálculo)" as sys_legacy #F1F5F9;line:64748B
actor "Servicio de IA\n(Gemini)" as sys_ai #F1F5F9;line:64748B

sys_sso -[hidden]down-> sys_mail
sys_mail -[hidden]down-> sys_drive
sys_drive -[hidden]down-> sys_wa
sys_wa -[hidden]down-> sys_bi
sys_bi -[hidden]down-> sys_legacy
sys_legacy -[hidden]down-> sys_ai

' =========================================================
' 4. RELACIONES ACTOR → CASO
' =========================================================
direccion --> uc_login
alta --> uc_login
admin --> uc_login
ogti --> uc_login

direccion --> uc_fusionar
direccion --> uc_validar
direccion --> uc_tableros
direccion --> uc_bitacora

alta --> uc_tableros

admin --> uc_usuarios
admin --> uc_bitacora

ogti --> uc_migracion
ogti --> uc_respaldo
ogti --> uc_ia

' =========================================================
' 5. RELACIONES ENTRE CASOS
' =========================================================
uc_validar ..> uc_difundir : <<include>>

' =========================================================
' 6. INTEGRACIONES EXTERNAS
' =========================================================
uc_login --> sys_sso
uc_difundir --> sys_mail
uc_difundir --> sys_wa
uc_difundir --> sys_drive
uc_tableros --> sys_bi
uc_migracion --> sys_legacy
uc_ia --> sys_ai

' =========================================================
' 7. CONTROLES TRANSVERSALES (no son casos de uso · ERS §3.4)
' =========================================================




@enduml


