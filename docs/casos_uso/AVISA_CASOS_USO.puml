  }

  package "Productos" {
    usecase "CU-13 · Armar y enviar\nproductos" as uc_productos
  }

  package "Procesamiento de documentos" {
    usecase "CU-20 · Procesar documentos y\nproponer candidatos" as uc_procesar
    usecase "CU-21 · Recolectar fuentes\nde la lista blanca" as uc_fuentes
    usecase "CU-22 · Revisar candidatos y\ncoincidencias dudosas" as uc_revisar
