# =============================================================================
#  AVISA · variables del entorno PostgreSQL local
#
#  Copiar a .env y cambiar POSTGRES_PASSWORD antes del primer arranque:
#      cp .env.example .env
#
#  .env NO se versiona (ver .gitignore). Este archivo sólo documenta la forma.
# =============================================================================

# Base y rol que crea el propio contenedor en el primer arranque.
POSTGRES_DB=avisa
POSTGRES_USER=avisa
POSTGRES_PASSWORD=cambia-esta-clave

# Puerto publicado en el host. 5432 suele estar ocupado por un PostgreSQL
# local; 55432 lo usa el contenedor de pruebas avisa-v9-test.
POSTGRES_PORT=55433

# Zona horaria del servidor y del cliente psql.
TZ=America/Lima

# Cadena de conexión que usará el cargador (asyncpg no acepta el prefijo
# `postgresql+asyncpg://` de SQLAlchemy: este es el formato para asyncpg).
DATABASE_URL=postgresql://avisa:cambia-esta-clave@localhost:55433/avisa
